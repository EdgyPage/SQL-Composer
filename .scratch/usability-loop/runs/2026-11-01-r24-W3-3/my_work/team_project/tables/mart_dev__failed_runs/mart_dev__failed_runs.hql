-- The Hive of mart_dev.failed_runs, generated by export_hive() from the logic cell of
-- mart_dev__failed_runs.ipynb, beside this file. Edit the logic there, not this file:
-- each export_hive() writes it again, from the notebook as last saved. It holds 2 steps,
-- in the order they are sent: create() and write().

-- 1 of 2: create()
CREATE EXTERNAL TABLE IF NOT EXISTS mart_dev.failed_runs (
  job_id BIGINT,
  fails BIGINT,
  PRIMARY KEY (job_id) DISABLE NOVALIDATE
)
STORED AS ORC
LOCATION '/data/team/mart_dev.db/failed_runs';

-- 2 of 2: write()
INSERT OVERWRITE TABLE mart_dev.failed_runs
SELECT
  r.job_id,
  COUNT(*) AS fails
FROM ops.job_runs AS r
WHERE
  r.status = 'FAILED'
GROUP BY
  r.job_id;
