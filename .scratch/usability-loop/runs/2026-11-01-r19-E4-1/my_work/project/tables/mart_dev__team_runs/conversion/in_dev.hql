WITH job_runs AS (SELECT r.job_id, r.duration_mins, jb.team FROM ops.job_runs AS r LEFT JOIN ops.jobs AS jb ON r.job_id = jb.job_id) INSERT OVERWRITE TABLE mart_dev.team_runs SELECT k.team, COALESCE(c.runs, 0) AS runs FROM (SELECT 'data' AS team UNION ALL SELECT 'finance' UNION ALL SELECT 'web') AS k LEFT JOIN (SELECT team, COUNT(*) AS runs FROM job_runs GROUP BY team) AS c ON k.team = c.team