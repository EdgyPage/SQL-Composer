-- The Hive of mart_dev.runs_per_day, generated by export_hive() from the logic cell of
-- mart_dev__runs_per_day.ipynb, beside this file. Edit the logic there, not this file:
-- each export_hive() writes it again, from the notebook as last saved. It holds 2 steps,
-- in the order they are sent: create() and write().

-- 1 of 2: create()
CREATE EXTERNAL TABLE IF NOT EXISTS mart_dev.runs_per_day (
  job_id BIGINT,
  runs BIGINT,
  PRIMARY KEY (job_id, dt) DISABLE NOVALIDATE
)
PARTITIONED BY (
  dt STRING
)
STORED AS ORC
LOCATION '/data/team/mart_dev.db/runs_per_day';

-- 2 of 2: write()
-- The Session setting "dynamic_partitions": this write fills dt from its rows.
SET hive.exec.dynamic.partition=true;
SET hive.exec.dynamic.partition.mode=nonstrict;
INSERT OVERWRITE TABLE mart_dev.runs_per_day PARTITION(dt)
SELECT
  job_runs.job_id,
  COUNT(*) AS runs,
  job_runs.dt
FROM ops.job_runs AS job_runs
WHERE
  job_runs.dt BETWEEN '2026-09-23' AND '2026-09-24'
GROUP BY
  job_runs.job_id,
  job_runs.dt;
