WITH job_runs AS (SELECT r.run_id, r.job_id, r.status, r.duration_mins, r.avg_retry_secs, r.dt, j.team FROM ops.job_runs AS r LEFT JOIN ops.jobs AS j ON r.job_id = j.job_id) INSERT OVERWRITE TABLE mart_dev.team_runs SELECT t.team, COALESCE(c.runs, 0) AS runs FROM (SELECT 'data' AS team UNION ALL SELECT 'finance' UNION ALL SELECT 'web') AS t LEFT JOIN (SELECT team, COUNT(*) AS runs FROM job_runs GROUP BY team) AS c ON t.team = c.team