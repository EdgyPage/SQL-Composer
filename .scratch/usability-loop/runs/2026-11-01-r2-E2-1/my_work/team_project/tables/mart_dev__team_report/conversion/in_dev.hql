WITH runs_with_team AS (SELECT r.job_id, r.duration_mins, j.team FROM ops.job_runs AS r LEFT JOIN ops.jobs AS j ON r.job_id = j.job_id), totals AS (SELECT team, COUNT(*) AS runs, SUM(duration_mins) AS total_duration_mins FROM runs_with_team GROUP BY team), team_names AS (SELECT 'data' AS team UNION ALL SELECT 'finance' UNION ALL SELECT 'web') INSERT OVERWRITE TABLE mart_dev.team_report SELECT n.team, COALESCE(t.runs, 0) AS runs, COALESCE(t.total_duration_mins, 0) AS total_duration_mins FROM team_names AS n LEFT JOIN totals AS t ON n.team = t.team