WITH job_runs AS (SELECT r.job_id, r.duration_mins, j.team FROM ops.job_runs AS r LEFT JOIN ops.jobs AS j ON r.job_id = j.job_id), typed_teams AS (SELECT 'data' AS team UNION ALL SELECT 'finance' UNION ALL SELECT 'web') INSERT OVERWRITE TABLE mart_dev.team_report SELECT t.team, COALESCE(c.runs, 0) AS runs, COALESCE(c.total_duration_mins, 0) AS total_duration_mins FROM typed_teams AS t LEFT JOIN (SELECT team, COUNT(*) AS runs, SUM(duration_mins) AS total_duration_mins FROM job_runs GROUP BY team) AS c ON t.team = c.team