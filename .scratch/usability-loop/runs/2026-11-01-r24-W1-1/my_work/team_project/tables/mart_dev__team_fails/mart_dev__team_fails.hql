-- The Hive of mart_dev.team_fails, generated by export_hive() from the logic cell of
-- mart_dev__team_fails.ipynb, beside this file. Edit the logic there, not this file:
-- each export_hive() writes it again, from the notebook as last saved. It holds 3 steps,
-- in the order they are sent: create(), session_settings() and write().

-- 1 of 3: create()
CREATE EXTERNAL TABLE IF NOT EXISTS mart_dev.team_fails (
  team STRING,
  fails BIGINT,
  PRIMARY KEY (team, dt) DISABLE NOVALIDATE
)
PARTITIONED BY (
  dt STRING
)
STORED AS ORC
LOCATION '/data/team/mart_dev.db/team_fails';

-- 2 of 3: session_settings()
-- Session settings: converted, sent one line at a time
SET hive.exec.dynamic.partition.mode=nonstrict;

-- 3 of 3: write()
-- The Session setting "dynamic_partitions": this write fills dt from its rows.
SET hive.exec.dynamic.partition=true;
SET hive.exec.dynamic.partition.mode=nonstrict;
WITH f AS (
  SELECT
    r.job_id,
    r.dt
  FROM ops.job_runs AS r
  WHERE
    r.status = 'FAILED'
)
INSERT OVERWRITE TABLE mart_dev.team_fails PARTITION(dt)
SELECT
  o.team,
  COUNT(*) AS fails,
  f.dt
FROM f
JOIN ops.job_owners AS o
  ON f.job_id = o.job_id
GROUP BY
  o.team,
  f.dt;
