-- The Hive of mart_dev.daily_runs, generated by export_hive() from the logic cell of
-- mart_dev__daily_runs.ipynb, beside this file. Edit the logic there, not this file:
-- each export_hive() writes it again, from the notebook as last saved. It holds 2 steps,
-- in the order they are sent: create() and write().

-- 1 of 2: create()
CREATE EXTERNAL TABLE IF NOT EXISTS mart_dev.daily_runs (
  dt STRING,
  runs BIGINT,
  total_duration_mins BIGINT,
  PRIMARY KEY (dt) DISABLE NOVALIDATE
)
STORED AS ORC
LOCATION '/data/team/mart_dev.db/daily_runs';

-- 2 of 2: write()
WITH d AS (
  SELECT
    '2026-09-23' AS dt
  UNION ALL
  SELECT
    '2026-09-24'
), cleanruns AS (
  SELECT
    job_runs.run_id,
    job_runs.job_id,
    job_runs.status,
    job_runs.duration_mins,
    job_runs.avg_retry_secs,
    job_runs.dt
  FROM ops.job_runs AS job_runs
  WHERE
    NOT job_runs.status IS NULL
    AND (
      job_runs.status <> 'TEST' OR job_runs.status IS NULL
    )
), c AS (
  SELECT
    cleanruns.dt,
    COUNT(*) AS runs,
    SUM(cleanruns.duration_mins) AS total_duration_mins
  FROM cleanruns
  GROUP BY
    cleanruns.dt
)
INSERT OVERWRITE TABLE mart_dev.daily_runs
SELECT
  d.dt,
  COALESCE(c.runs, 0) AS runs,
  COALESCE(c.total_duration_mins, 0) AS total_duration_mins
FROM d
LEFT JOIN c
  ON d.dt = c.dt;
