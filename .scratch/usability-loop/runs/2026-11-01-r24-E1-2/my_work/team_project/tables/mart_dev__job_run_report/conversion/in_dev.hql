INSERT OVERWRITE TABLE mart_dev.job_run_report SELECT j.job_id, COALESCE(c.runs, 0) AS runs, COALESCE(f.failed_runs, 0) AS failed_runs, a.avg_duration_mins FROM (SELECT 1 AS job_id UNION ALL SELECT 2 UNION ALL SELECT 3) AS j LEFT JOIN (SELECT job_id, COUNT(*) AS runs FROM ops.job_runs GROUP BY job_id) AS c ON j.job_id = c.job_id LEFT JOIN (SELECT job_id, COUNT(*) AS failed_runs FROM ops.job_runs WHERE status = 'FAILED' GROUP BY job_id) AS f ON j.job_id = f.job_id LEFT JOIN (SELECT job_id, AVG(duration_mins) AS avg_duration_mins FROM ops.job_runs GROUP BY job_id) AS a ON j.job_id = a.job_id