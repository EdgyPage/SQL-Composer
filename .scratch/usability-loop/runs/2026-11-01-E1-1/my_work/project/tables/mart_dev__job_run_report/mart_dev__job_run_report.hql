-- The Hive of mart_dev.job_run_report, generated by export_hive() from the logic cell of
-- mart_dev__job_run_report.ipynb, beside this file. Edit the logic there, not this file:
-- each export_hive() writes it again, from the notebook as last saved. It holds 2 steps,
-- in the order they are sent: create() and write().

-- 1 of 2: create()
CREATE EXTERNAL TABLE IF NOT EXISTS mart_dev.job_run_report (
  job_id BIGINT,
  runs BIGINT,
  failed_runs BIGINT,
  avg_duration_mins DOUBLE,
  PRIMARY KEY (job_id) DISABLE NOVALIDATE
)
STORED AS ORC
LOCATION '/data/team/mart_dev.db/job_run_report';

-- 2 of 2: write()
INSERT OVERWRITE TABLE mart_dev.job_run_report
SELECT
  job_runs.job_id,
  COALESCE(COUNT(*), 0) AS runs,
  COALESCE(COUNT(CASE WHEN job_runs.status = 'FAILED' THEN 1 END), 0) AS failed_runs,
  AVG(job_runs.duration_mins) AS avg_duration_mins
FROM ops.job_runs AS job_runs
GROUP BY
  job_runs.job_id;
