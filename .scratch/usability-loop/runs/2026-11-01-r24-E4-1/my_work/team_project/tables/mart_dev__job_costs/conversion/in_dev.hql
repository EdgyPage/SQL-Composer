WITH job_runs AS (SELECT r.run_id, r.job_id, r.status, r.duration_mins, r.avg_retry_secs, r.dt, j.team FROM ops.job_runs AS r LEFT JOIN ops.jobs AS j ON r.job_id = j.job_id) INSERT OVERWRITE TABLE mart_dev.job_costs SELECT g.job_id, CASE WHEN g.job_id = 3 THEN 1000 ELSE COALESCE(s.total, 0) * 50 END AS cost_cents FROM (SELECT 1 AS job_id UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4) AS g LEFT JOIN (SELECT job_id, SUM(duration_mins) AS total FROM job_runs GROUP BY job_id) AS s ON g.job_id = s.job_id