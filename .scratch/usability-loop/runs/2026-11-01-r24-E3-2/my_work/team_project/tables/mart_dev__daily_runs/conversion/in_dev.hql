WITH CleanRuns AS (SELECT run_id, job_id, status, duration_mins, avg_retry_secs, dt FROM ops.job_runs WHERE NOT status IS NULL AND status <> 'TEST') INSERT OVERWRITE TABLE mart_dev.daily_runs SELECT d.dt, COALESCE(c.runs, 0) AS runs, COALESCE(s.total_duration_mins, 0) AS total_duration_mins FROM (SELECT '2026-09-23' AS dt UNION ALL SELECT '2026-09-24') AS d LEFT JOIN (SELECT dt, COUNT(*) AS runs FROM CleanRuns GROUP BY dt) AS c ON d.dt = c.dt LEFT JOIN (SELECT dt, SUM(duration_mins) AS total_duration_mins FROM CleanRuns GROUP BY dt) AS s ON d.dt = s.dt