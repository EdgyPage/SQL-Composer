-- The Hive of mart.team_days, generated by export_hive() from the logic cell of
-- mart__team_days.ipynb, beside this file. Edit the logic there, not this file: each
-- export_hive() writes it again, from the notebook as last saved. It holds 2 steps, in
-- the order they are sent: create() and write().

-- 1 of 2: create()
CREATE EXTERNAL TABLE IF NOT EXISTS mart.team_days (
  team STRING,
  events BIGINT,
  runs BIGINT,
  minutes BIGINT,
  cost_cents BIGINT,
  PRIMARY KEY (team, dt) DISABLE NOVALIDATE
)
PARTITIONED BY (
  dt STRING
)
STORED AS ORC
LOCATION '/data/your_team/mart.db/team_days';

-- 2 of 2: write()
-- The Session setting "dynamic_partitions": this write fills dt from its rows.
SET hive.exec.dynamic.partition=true;
SET hive.exec.dynamic.partition.mode=nonstrict;
INSERT OVERWRITE TABLE mart.team_days PARTITION(dt)
SELECT
  job_day_facts.team,
  SUM(job_day_facts.events) AS events,
  SUM(job_day_facts.runs) AS runs,
  SUM(job_day_facts.minutes) AS minutes,
  SUM(job_day_costs.cost_cents) AS cost_cents,
  job_day_facts.dt
FROM mart.job_day_facts AS job_day_facts
LEFT JOIN mart.job_day_costs AS job_day_costs
  ON job_day_costs.job_id = job_day_facts.job_id
  AND job_day_costs.dt = job_day_facts.dt
  AND job_day_costs.dt BETWEEN '2026-09-22' AND '2026-09-24'
WHERE
  job_day_facts.dt BETWEEN '2026-09-22' AND '2026-09-24'
GROUP BY
  job_day_facts.dt,
  job_day_facts.team;
