-- The Hive of mart.job_notes, generated by export_hive() from the logic cell of
-- mart__job_notes.ipynb, beside this file. Edit the logic there, not this file: each
-- export_hive() writes it again, from the notebook as last saved. It holds 2 steps, in
-- the order they are sent: create() and write().

-- 1 of 2: create()
CREATE EXTERNAL TABLE IF NOT EXISTS mart.job_notes (
  job_id BIGINT,
  team STRING,
  note STRING,
  written_on STRING
)
STORED AS ORC
LOCATION '/data/your_team/mart.db/job_notes';

-- 2 of 2: write()
INSERT OVERWRITE TABLE mart.job_notes
SELECT
  job_owners.job_id,
  team_notes.team,
  team_notes.note,
  team_notes.written_on
FROM ops.team_notes AS team_notes
JOIN ops.job_owners AS job_owners
  ON job_owners.team = team_notes.team
  AND job_owners.dt = team_notes.written_on
  AND job_owners.dt BETWEEN '2026-09-11' AND '2026-09-24';
