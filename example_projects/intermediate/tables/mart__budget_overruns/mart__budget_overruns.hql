-- The Hive of mart.budget_overruns, generated by export_hive() from the logic cell of
-- mart__budget_overruns.ipynb, beside this file. Edit the logic there, not this file:
-- each export_hive() writes it again, from the notebook as last saved. Its steps are in
-- the order they are sent: create(), any seed(), the table's Session settings, then
-- write().

-- 1 of 3: create()
CREATE EXTERNAL TABLE IF NOT EXISTS mart.budget_overruns (
  job_id BIGINT,
  budget_cents BIGINT,
  days BIGINT,
  days_over BIGINT,
  PRIMARY KEY (job_id, region) DISABLE NOVALIDATE
)
PARTITIONED BY (
  region STRING
)
STORED AS ORC
LOCATION '/data/your_team/mart.db/budget_overruns';

-- 2 of 3: write()[0]
INSERT OVERWRITE TABLE mart.budget_overruns PARTITION(region = 'eu')
SELECT
  region_costs.job_id,
  region_budgets.budget_cents,
  COUNT(*) AS days,
  COUNT(CASE WHEN region_costs.cost_cents > region_budgets.budget_cents THEN 1 END) AS days_over
FROM ops.region_costs AS region_costs
JOIN ops.region_budgets AS region_budgets
  ON region_budgets.job_id = region_costs.job_id AND region_budgets.region = 'eu'
WHERE
  region_costs.region = 'eu' AND region_costs.dt BETWEEN '20260911' AND '20260924'
GROUP BY
  region_costs.job_id,
  region_budgets.budget_cents;

-- 3 of 3: write()[1]
INSERT OVERWRITE TABLE mart.budget_overruns PARTITION(region = 'us')
SELECT
  region_costs.job_id,
  region_budgets.budget_cents,
  COUNT(*) AS days,
  COUNT(CASE WHEN region_costs.cost_cents > region_budgets.budget_cents THEN 1 END) AS days_over
FROM ops.region_costs AS region_costs
JOIN ops.region_budgets AS region_budgets
  ON region_budgets.job_id = region_costs.job_id AND region_budgets.region = 'us'
WHERE
  region_costs.region = 'us' AND region_costs.dt BETWEEN '20260911' AND '20260924'
GROUP BY
  region_costs.job_id,
  region_budgets.budget_cents;
