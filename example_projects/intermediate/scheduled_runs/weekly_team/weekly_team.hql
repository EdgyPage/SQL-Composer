-- The Hive of the Scheduled run weekly_team, generated by
-- project.export_run_hive("weekly_team") from weekly_team.ipynb, beside this file, built
-- as its Build cell builds it, with the defaults of its # parameters cell, sending
-- nothing. It is to read, never to edit or to send: the notebook builds its Hive again
-- each time it runs, its Run values worked out then, so this file is never what is sent.
-- To change it, edit the notebook, save it and call
-- project.export_run_hive("weekly_team") again. It holds 4 Statements.
--
-- Parameters, as this run uses them:
--   START_FROM = ""
--   WEEK = None

-- 1 of 4: mart.job_day_costs (read by mart.team_days)
-- The Session setting "dynamic_partitions": this write fills dt from its rows.
SET hive.exec.dynamic.partition=true;
SET hive.exec.dynamic.partition.mode=nonstrict;
WITH costs_per_job AS (
  SELECT
    region_costs.job_id,
    SUM(region_costs.cost_cents) AS cost_cents,
    CONCAT(
      SUBSTRING(region_costs.dt, 1, 4),
      '-',
      SUBSTRING(region_costs.dt, 5, 2),
      '-',
      SUBSTRING(region_costs.dt, 7, 2)
    ) AS dt
  FROM ops.region_costs AS region_costs
  WHERE
    region_costs.dt BETWEEN '20260922' AND '20260924'
  GROUP BY
    region_costs.job_id,
    CONCAT(
      SUBSTRING(region_costs.dt, 1, 4),
      '-',
      SUBSTRING(region_costs.dt, 5, 2),
      '-',
      SUBSTRING(region_costs.dt, 7, 2)
    )
)
INSERT OVERWRITE TABLE mart.job_day_costs PARTITION(dt)
SELECT
  costs_per_job.job_id,
  costs_per_job.cost_cents,
  costs_per_job.dt
FROM costs_per_job;

-- 2 of 4: mart.job_day_facts (read by mart.team_days)
-- The Session setting "dynamic_partitions": this write fills dt from its rows.
SET hive.exec.dynamic.partition=true;
SET hive.exec.dynamic.partition.mode=nonstrict;
WITH events_per_job AS (
  SELECT
    job_events.job_id,
    job_events.dt,
    COUNT(*) AS events,
    COUNT(CASE WHEN job_events.event_type = 'start' THEN 1 END) AS runs,
    COALESCE(
      SUM(
        CASE WHEN job_events.event_type IN ('finish', 'fail') THEN job_events.minutes END
      ),
      0
    ) AS minutes
  FROM ops.job_events AS job_events
  WHERE
    job_events.dt BETWEEN '2026-09-22' AND '2026-09-24'
  GROUP BY
    job_events.job_id,
    job_events.dt
)
INSERT OVERWRITE TABLE mart.job_day_facts PARTITION(dt)
SELECT
  events_per_job.job_id,
  job_owners.team,
  events_per_job.events,
  events_per_job.runs,
  events_per_job.minutes,
  events_per_job.dt
FROM events_per_job
LEFT JOIN ops.job_owners AS job_owners
  ON job_owners.job_id = events_per_job.job_id
  AND job_owners.dt = events_per_job.dt
  AND job_owners.dt BETWEEN '2026-09-22' AND '2026-09-24';

-- 3 of 4: mart.team_days (read by week_totals)
-- The Session setting "dynamic_partitions": this write fills dt from its rows.
SET hive.exec.dynamic.partition=true;
SET hive.exec.dynamic.partition.mode=nonstrict;
INSERT OVERWRITE TABLE mart.team_days PARTITION(dt)
SELECT
  job_day_facts.team,
  SUM(job_day_facts.events) AS events,
  SUM(job_day_facts.runs) AS runs,
  SUM(job_day_facts.minutes) AS minutes,
  SUM(job_day_costs.cost_cents) AS cost_cents,
  job_day_facts.dt
FROM mart.job_day_facts AS job_day_facts
LEFT JOIN mart.job_day_costs AS job_day_costs
  ON job_day_costs.job_id = job_day_facts.job_id
  AND job_day_costs.dt = job_day_facts.dt
  AND job_day_costs.dt BETWEEN '2026-09-22' AND '2026-09-24'
WHERE
  job_day_facts.dt BETWEEN '2026-09-22' AND '2026-09-24'
GROUP BY
  job_day_facts.dt,
  job_day_facts.team;

-- 4 of 4: week_totals
SELECT
  CAST(NEXT_DAY(DATE_ADD(team_days.dt, 7 * -1), 'MO') AS STRING) AS week,
  team_days.team,
  SUM(team_days.events) AS events,
  SUM(team_days.runs) AS runs,
  SUM(team_days.minutes) AS minutes,
  SUM(team_days.cost_cents) AS cost_cents
FROM mart.team_days AS team_days
WHERE
  team_days.dt BETWEEN '2026-09-21' AND '2026-09-27'
GROUP BY
  CAST(NEXT_DAY(DATE_ADD(team_days.dt, 7 * -1), 'MO') AS STRING),
  team_days.team;
