-- The Hive of mart.daily_job_runs, generated by export_hive() from the logic cell of
-- mart__daily_job_runs.ipynb, beside this file. Edit the logic there, not this file:
-- each export_hive() writes it again, from the notebook as last saved. It holds 2 steps,
-- in the order they are sent: create() and write().

-- 1 of 2: create()
CREATE EXTERNAL TABLE IF NOT EXISTS mart.daily_job_runs (
  job_id BIGINT,
  runs BIGINT,
  failed_runs BIGINT,
  minutes BIGINT,
  PRIMARY KEY (job_id, dt) DISABLE NOVALIDATE
)
PARTITIONED BY (
  dt STRING
)
STORED AS ORC
LOCATION '/data/your_team/mart.db/daily_job_runs';

-- 2 of 2: write()
-- The Session setting "dynamic_partitions": this write fills dt from its rows.
SET hive.exec.dynamic.partition=true;
SET hive.exec.dynamic.partition.mode=nonstrict;
WITH runs_per_job AS (
  SELECT
    job_runs.job_id,
    job_runs.dt,
    COUNT(*) AS runs,
    COUNT(CASE WHEN job_runs.status = 'FAILED' THEN 1 END) AS failed_runs,
    SUM(job_runs.duration_mins) AS minutes
  FROM ops.job_runs AS job_runs
  WHERE
    job_runs.dt = '2026-09-24'
  GROUP BY
    job_runs.job_id,
    job_runs.dt
)
INSERT OVERWRITE TABLE mart.daily_job_runs PARTITION(dt)
SELECT
  runs_per_job.job_id,
  runs_per_job.runs,
  runs_per_job.failed_runs,
  runs_per_job.minutes,
  runs_per_job.dt
FROM runs_per_job;
