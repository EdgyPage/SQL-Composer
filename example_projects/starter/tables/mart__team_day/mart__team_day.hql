-- The Hive of mart.team_day, generated by export_hive() from the logic cell of
-- mart__team_day.ipynb, beside this file. Edit the logic there, not this file: each
-- export_hive() writes it again, from the notebook as last saved. It holds 2 steps, in
-- the order they are sent: create() and write().

-- 1 of 2: create()
CREATE EXTERNAL TABLE IF NOT EXISTS mart.team_day (
  team STRING,
  runs BIGINT,
  failed_runs BIGINT,
  minutes BIGINT,
  PRIMARY KEY (team, dt) DISABLE NOVALIDATE
)
PARTITIONED BY (
  dt STRING
)
STORED AS ORC
LOCATION '/data/your_team/mart.db/team_day';

-- 2 of 2: write()
-- The Session setting "dynamic_partitions": this write fills dt from its rows.
SET hive.exec.dynamic.partition=true;
SET hive.exec.dynamic.partition.mode=nonstrict;
INSERT OVERWRITE TABLE mart.team_day PARTITION(dt)
SELECT
  jobs.team,
  SUM(daily_job_runs.runs) AS runs,
  SUM(daily_job_runs.failed_runs) AS failed_runs,
  SUM(daily_job_runs.minutes) AS minutes,
  daily_job_runs.dt
FROM mart.daily_job_runs AS daily_job_runs
JOIN ops.jobs AS jobs
  ON jobs.job_id = daily_job_runs.job_id
WHERE
  daily_job_runs.dt = '2026-09-24'
GROUP BY
  jobs.team,
  daily_job_runs.dt;
