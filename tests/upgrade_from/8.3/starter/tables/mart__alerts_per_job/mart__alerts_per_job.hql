-- The Hive of mart.alerts_per_job, generated by export_hive() from the logic cell of
-- mart__alerts_per_job.ipynb, beside this file. Edit the logic there, not this file:
-- each export_hive() writes it again, from the notebook as last saved. It holds 2 steps,
-- in the order they are sent: create() and write().

-- 1 of 2: create()
CREATE EXTERNAL TABLE IF NOT EXISTS mart.alerts_per_job (
  job_id BIGINT,
  alerts BIGINT,
  high_alerts BIGINT,
  PRIMARY KEY (job_id, dt) DISABLE NOVALIDATE
)
PARTITIONED BY (
  dt STRING
)
STORED AS ORC
LOCATION '/data/your_team/mart.db/alerts_per_job';

-- 2 of 2: write()
-- The Session setting "dynamic_partitions": this write fills dt from its rows.
SET hive.exec.dynamic.partition=true;
SET hive.exec.dynamic.partition.mode=nonstrict;
INSERT OVERWRITE TABLE mart.alerts_per_job PARTITION(dt)
SELECT
  job_runs.job_id,
  COUNT(*) AS alerts,
  COUNT(CASE WHEN run_alerts.severity = 'high' THEN 1 END) AS high_alerts,
  run_alerts.dt
FROM ops.run_alerts AS run_alerts
JOIN ops.job_runs AS job_runs
  ON job_runs.run_id = run_alerts.run_id
WHERE
  run_alerts.dt = '2026-09-24'
  AND job_runs.dt BETWEEN '2026-09-23' AND '2026-09-24'
GROUP BY
  job_runs.job_id,
  run_alerts.dt;
